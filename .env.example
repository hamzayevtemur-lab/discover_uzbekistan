# Discover Uzbekistan Production Environment Configuration

# Security Secret Keys (Generate unique random strings for production)
SECRET_KEY=your_production_secret_key_here
ADMIN_SECRET_KEY=your_admin_production_secret_key_here

# Database Configuration (MySQL)
DB_HOST=db
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_secure_db_password
DB_NAME=discover_uzbekistan

# Admin Passwords
ADMIN_LOGIN_PASSWORD=your_secure_admin_password
CONTENT_ADMIN_PASSWORD=your_secure_content_password
NEWS_ADMIN_PASSWORD=your_secure_news_password

# Email / SMTP Configuration
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_PORT=465
ADMIN_EMAIL=your_email@gmail.com
RESEND_API_KEY=re_your_resend_key_here

# Frontend Base URL
FRONTEND_BASE=http://your-domain-or-vps-ip.com
